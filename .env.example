# Public, non-secret values for the brochure build and the supported OpenClaw
# runtime. WebChess 2.2 gameplay, model inference, and research are available
# only through `openclaw webchess` with one OpenAI account/OAuth profile. Do not
# add any provider API key, token, service-account file, or alternate-provider
# credential to this file; startup rejects those credentials by variable name.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/account
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/account

# Local OpenClaw plugin mode. `openclaw webchess` sets ENABLED and TRANSPORT
# internally; ordinary users do not need to copy or edit those values. The
# launcher fixes each model turn at 150 seconds and each consented Hosted
# Search at 300 seconds. Never put a model credential or custom executable
# here: the supported plugin uses only the selected
# OpenAI account/OAuth profile and its fixed, attested transport.
WEBCHESS_OPENCLAW_ENABLED=
WEBCHESS_OPENCLAW_TRANSPORT=local
WEBCHESS_OPENCLAW_TIMEOUT_MS=150000
WEBCHESS_OPENCLAW_SEARCH_TIMEOUT_MS=300000
# Required only for `openclaw webchess`: a dedicated PostgreSQL 17 database on
# numeric loopback 127.0.0.1 or ::1. Never point this at hosted or production data.
WEBCHESS_OPENCLAW_DATABASE_URL=

# Clerk and hosted database variables remain only for brochure/deployment
# maintenance and historical hosted-account code. They do not authorize a
# playable WebChess 2.2 runtime: every non-OpenClaw API principal fails closed.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon pooled connection string for the least-privileged application runtime
# role. Use a separate database or branch per environment. Apply all 17
# canonical migrations only through `npm run db:migrate` with a separate
# migration owner; never put that owner's credential in .env.local or Vercel.
DATABASE_URL=

# At least 32 random bytes. Used only through purpose-separated HMAC labels for
# pseudonymous rate-limit keys and OpenAI safety identifiers. Rotation changes
# derived identifiers, so coordinate it as an operational migration.
WEBCHESS_HMAC_SECRET=
# Lifetime-stable while deletion tombstones exist. Do not rotate this with the
# normal rate/safety HMAC secret because deleted raw user IDs are unavailable
# for rehashing.
WEBCHESS_DELETION_HMAC_SECRET=

# Durable default allowances. Per-user overrides and suspensions live in Neon.
# New divisions and replays share the game-start limits. Wilbur action and
# observation writes, plus account exports, have independent user/IP limits.
# Account exports also have a hard serialized-response byte ceiling.
WEBCHESS_DAILY_GAME_LIMIT=2
WEBCHESS_DAILY_MODEL_REQUEST_LIMIT=100
WEBCHESS_DAILY_GLOBAL_MODEL_REQUEST_LIMIT=200
WEBCHESS_HOURLY_MODEL_REQUEST_LIMIT=20
WEBCHESS_HOURLY_IP_MODEL_REQUEST_LIMIT=40
WEBCHESS_HOURLY_GAME_START_LIMIT=20
WEBCHESS_HOURLY_IP_GAME_START_LIMIT=40
WEBCHESS_HOURLY_GAME_MOVE_LIMIT=600
WEBCHESS_HOURLY_IP_GAME_MOVE_LIMIT=1200
WEBCHESS_HOURLY_ACCOUNT_EXPORT_LIMIT=2
WEBCHESS_HOURLY_IP_ACCOUNT_EXPORT_LIMIT=10
WEBCHESS_HOURLY_WILBUR_ACTION_LIMIT=120
WEBCHESS_HOURLY_IP_WILBUR_ACTION_LIMIT=240
WEBCHESS_HOURLY_WILBUR_OBSERVATION_LIMIT=60
WEBCHESS_HOURLY_IP_WILBUR_OBSERVATION_LIMIT=120
WEBCHESS_ACCOUNT_EXPORT_MAX_BYTES=3000000
# Lifetime Wilbur admission envelope. Rows include actions, observations,
# Wilbur lifecycle events, mutation-ledger rows, and pending reservations; text
# bytes are exact UTF-8 bytes. Existing over-limit history is preserved. The
# export ceiling can reduce these effective maxima; this is not a whole-account
# export guarantee.
WEBCHESS_WILBUR_STORAGE_ROW_LIMIT=500
WEBCHESS_WILBUR_STORAGE_TEXT_BYTES_LIMIT=250000
WEBCHESS_CONCURRENT_MODEL_LIMIT=1
WEBCHESS_GLOBAL_MODEL_CONCURRENT_LIMIT=4
# Per-turn minimum: 150 seconds of provider work plus 30 seconds for durable
# settlement. Answer renews this lease before each turn inside one 300-second
# aggregate operation window; this value is not the Answer deadline.
WEBCHESS_MODEL_LEASE_SECONDS=180

# Optional deployment metadata used for provenance. Vercel supplies its own
# commit/deployment values; local development may leave these empty.
WEBCHESS_SOFTWARE_VERSION=
# Optional immutable override used only if Vercel does not supply
# VERCEL_GIT_COMMIT_SHA for the reviewed deployment.
WEBCHESS_RELEASE_SHA=
