{
  "name": "webchess",
  "private": true,
  "version": "2.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jr4488/webchess.git"
  },
  "homepage": "https://github.com/jr4488/webchess",
  "bugs": {
    "url": "https://github.com/jr4488/webchess/issues"
  },
  "files": [
    "openclaw.plugin.json",
    "openclaw-plugin/dist",
    "openclaw-plugin/src",
    "db",
    "src",
    "public",
    "docs",
    "next.config.ts",
    "tsconfig.json",
    "README.md",
    "INSTALL.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "nanoid": "3.3.18"
  },
  "type": "module",
  "packageManager": "npm@11.14.1",
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./openclaw-plugin/src/index.ts"
    ],
    "runtimeExtensions": [
      "./openclaw-plugin/dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    }
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "downloads:generate": "node scripts/generate-downloads.mjs",
    "plugin:build": "tsc -p openclaw-plugin/tsconfig.json",
    "db:migrate": "node scripts/deployment-migrate.mjs",
    "db:schema:check": "node scripts/deployment-schema-check.mjs",
    "release:verify-source": "node scripts/deployment-source-check.mjs",
    "local:setup": "node scripts/local-hosted.mjs setup",
    "local:dev": "node scripts/local-hosted.mjs dev",
    "local:down": "node scripts/local-hosted.mjs down",
    "predev": "npm run downloads:generate",
    "dev": "next dev",
    "prebuild": "node scripts/deployment-preflight.mjs && npm run db:schema:check -- --vercel-only && npm run downloads:generate",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:links": "playwright test --project=links",
    "verify:openclaw": "npm run lint && npm run typecheck && npm run plugin:build && npm run test && npm run build && npm run test:a11y && npm run test:e2e && npm audit --omit=dev --audit-level=high && npm audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm run plugin:build && npm run test:coverage && npm run test:integration && npm run build && npm run test:a11y && npm run test:e2e && npm audit --omit=dev --audit-level=high && npm audit --audit-level=high"
  },
  "dependencies": {
    "@clerk/nextjs": "7.6.1",
    "@neondatabase/serverless": "1.1.0",
    "@react-three/fiber": "9.6.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "lucide-react": "1.25.0",
    "next": "16.2.12",
    "openai": "6.49.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/pg": "8.20.0",
    "@types/three": "0.185.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
