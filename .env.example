# Create an API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# WebChess uses the requested frontier reasoning model by default.
OPENAI_MODEL=gpt-5.6-sol

# Required when the model-backed API is enabled. The access code must contain at
# least 12 characters. The session secret must contain at least 32 bytes. Use
# long, unique values and never reuse either one as an OpenAI key or password.
WEBCHESS_ACCESS_CODE=
WEBCHESS_SESSION_SECRET=

# Optional comma-separated browser origins allowed to call the API. When empty,
# WebChess accepts only the origin matching the request Host header.
WEBCHESS_ALLOWED_ORIGINS=

# Optional server settings
PORT=5173
HOST=127.0.0.1
