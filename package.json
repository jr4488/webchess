{
  "name": "webchess",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jr4488/webchess.git"
  },
  "homepage": "https://github.com/jr4488/webchess",
  "bugs": {
    "url": "https://github.com/jr4488/webchess/issues"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": "22.x",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "downloads:generate": "node scripts/generate-downloads.mjs",
    "db:migrate": "node scripts/deployment-migrate.mjs",
    "db:schema:check": "node scripts/deployment-schema-check.mjs",
    "release:verify-source": "node scripts/deployment-source-check.mjs",
    "predev": "npm run downloads:generate",
    "dev": "next dev",
    "prebuild": "node scripts/deployment-preflight.mjs && npm run db:schema:check -- --vercel-only && npm run downloads:generate",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:e2e": "playwright test",
    "test:links": "playwright test --project=links",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:integration && npm run build && npm run test:a11y && npm run test:e2e && npm audit --omit=dev --audit-level=high && npm audit --audit-level=high"
  },
  "dependencies": {
    "@clerk/nextjs": "7.6.1",
    "@neondatabase/serverless": "1.1.0",
    "lucide-react": "1.25.0",
    "next": "16.2.12",
    "openai": "6.49.0",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
