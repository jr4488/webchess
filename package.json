{
  "name": "webchess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run test:coverage && npm run lint && npm run build && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "express": "5.2.1",
    "lucide-react": "1.25.0",
    "openai": "6.48.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "undici": "7.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
