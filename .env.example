# Select exactly one provider:
# - openai-api (default): direct Responses API with Platform billing.
# - codex-chatgpt: signed-in Codex CLI allowance; single-owner loopback use only.
# - ollama: local OpenAI-compatible Ollama endpoint; loopback use only.
WEBCHESS_MODEL_PROVIDER=openai-api

# Required only for openai-api. Create a project key at
# https://platform.openai.com/api-keys. It is ignored in local provider modes.
OPENAI_API_KEY=

# Model used by the selected provider.
OPENAI_MODEL=gpt-5.6-sol

# ollama only: WebChess accepts an HTTP /v1 endpoint only on localhost or a
# loopback IP address. Ollama 0.13.3 or newer is required for /v1/responses.
WEBCHESS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# codex-chatgpt only: controls the native Responses web_search tool. Allowed
# values are disabled, cached, indexed, and live. The secure default is
# disabled. This does not enable Codex shell tools, browser control, or the
# separate standalone_web_search feature. Review README.md before opting in.
WEBCHESS_CODEX_WEB_SEARCH=disabled

# codex-chatgpt requires Linux, a safely root-owned `bwrap`, and the standalone
# static Linux ELF payload from Codex CLI 0.145.0. A JavaScript launcher or
# dynamically linked executable is rejected.
# Required in that mode: a separate, absolute canonical directory owned by the
# WebChess user with mode 0700 and file credential storage. Do not use ~/.codex.
# Create and authenticate it with the exact commands in README.md. WebChess
# never reads or copies the shared Codex auth and never provides a login UI.
WEBCHESS_CODEX_HOME=

# Optional only when `codex` on PATH already resolves to that static payload.
# Otherwise set its absolute canonical path. Pinning its SHA-256 is strongly
# recommended; calculate it with `sha256sum "$WEBCHESS_CODEX_PATH"`.
WEBCHESS_CODEX_PATH=
WEBCHESS_CODEX_SHA256=

# Optional sandbox paths. Bubblewrap must be root-owned, non-writable by other
# users, and beneath equally safe ancestor directories. The CA override is
# needed only when none of the standard Linux CA-bundle paths exists.
WEBCHESS_BWRAP_PATH=
WEBCHESS_CA_BUNDLE_PATH=

# Restart WebChess after changing the provider, model, Ollama endpoint,
# web-search mode, executable, sandbox resources, or dedicated login.

# Required for all provider modes. The access code must contain at least
# 12 characters. The session secret must contain at least 32 bytes. Use long,
# unique values and never reuse either one as an OpenAI key or password.
WEBCHESS_ACCESS_CODE=
WEBCHESS_SESSION_SECRET=

# Optional comma-separated browser origins allowed to call the API. When empty,
# WebChess accepts only the origin matching the request Host header. Leave this
# empty in local provider modes; only their loopback origin is allowed.
WEBCHESS_ALLOWED_ORIGINS=

# API mode only: optional comma-separated IP/CIDR allowlist for reverse proxies
# that connect directly to WebChess. Default false. Do not use true, hop counts,
# hostnames, or broad networks; untrusted X-Forwarded-For values are ignored.
WEBCHESS_TRUST_PROXY=false

# Optional request timeout from 1 through 3600000 milliseconds. The default is
# 120000; a large local model may need 600000 for the 64-facet first run.
WEBCHESS_UPSTREAM_TIMEOUT_MS=120000

# Local providers require HOST=127.0.0.1 and must never be exposed through a
# LAN, public listener, or reverse proxy.
PORT=5173
HOST=127.0.0.1
