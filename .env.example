# Public, non-secret values. Keep localhost for local development. Vercel
# Preview may omit NEXT_PUBLIC_SITE_URL and derive its exact HTTPS origin from
# VERCEL_URL. Production must set exactly
# https://webchess.anansiportia.com, with no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/play
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/play

# Local OpenClaw plugin mode. `openclaw webchess` sets ENABLED and TRANSPORT
# automatically; ordinary users do not need to copy or edit these values.
# The executable and timeout are optional troubleshooting overrides. Never put
# a model credential here: OpenClaw uses its own configured provider and auth.
WEBCHESS_OPENCLAW_ENABLED=
WEBCHESS_OPENCLAW_BIN=
WEBCHESS_OPENCLAW_TRANSPORT=local
WEBCHESS_OPENCLAW_TIMEOUT_MS=130000

# Clerk server credential. Configure Google, email, and passkey sign-in in the
# Clerk dashboard. Never expose either of these server values to the browser.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon pooled connection string for the least-privileged application runtime
# role. Use a separate database or branch per environment. Apply
# db/migrations/0001_durable_webchess.sql with a separate migration owner, and
# never put that owner's credential in .env.local or Vercel.
DATABASE_URL=

# WebChess-owned OpenAI Platform project key. The model is fixed in server code
# to gpt-5.6-sol; visitors never provide an API key or select a model.
OPENAI_API_KEY=

# At least 32 random bytes. Used only through purpose-separated HMAC labels for
# pseudonymous rate-limit keys and OpenAI safety identifiers. Rotation changes
# derived identifiers, so coordinate it as an operational migration.
WEBCHESS_HMAC_SECRET=
# Lifetime-stable while deletion tombstones exist. Do not rotate this with the
# normal rate/safety HMAC secret because deleted raw user IDs are unavailable
# for rehashing.
WEBCHESS_DELETION_HMAC_SECRET=

# Durable default allowances. Per-user overrides and suspensions live in Neon.
# New divisions and replays share the game-start limits. Account exports have
# independent user/IP limits and a hard serialized-response byte ceiling.
WEBCHESS_DAILY_GAME_LIMIT=2
WEBCHESS_DAILY_MODEL_REQUEST_LIMIT=100
WEBCHESS_DAILY_GLOBAL_MODEL_REQUEST_LIMIT=200
WEBCHESS_HOURLY_MODEL_REQUEST_LIMIT=20
WEBCHESS_HOURLY_IP_MODEL_REQUEST_LIMIT=40
WEBCHESS_HOURLY_GAME_START_LIMIT=20
WEBCHESS_HOURLY_IP_GAME_START_LIMIT=40
WEBCHESS_HOURLY_GAME_MOVE_LIMIT=600
WEBCHESS_HOURLY_IP_GAME_MOVE_LIMIT=1200
WEBCHESS_HOURLY_ACCOUNT_EXPORT_LIMIT=2
WEBCHESS_HOURLY_IP_ACCOUNT_EXPORT_LIMIT=10
WEBCHESS_ACCOUNT_EXPORT_MAX_BYTES=3000000
WEBCHESS_CONCURRENT_MODEL_LIMIT=1
WEBCHESS_GLOBAL_MODEL_CONCURRENT_LIMIT=4
WEBCHESS_MODEL_LEASE_SECONDS=180

# Optional deployment metadata used for provenance. Vercel supplies its own
# commit/deployment values; local development may leave these empty.
WEBCHESS_SOFTWARE_VERSION=
# Optional immutable override used only if Vercel does not supply
# VERCEL_GIT_COMMIT_SHA for the reviewed deployment.
WEBCHESS_RELEASE_SHA=
